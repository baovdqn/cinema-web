# Backend Spring Boot (baovdqn/cinema-booking) — Next rewrite /api/* sang đây
BACKEND_URL=http://localhost:8080
# axios gọi qua proxy của Next. Đổi thành URL tuyệt đối nếu backend đã bật CORS.
NEXT_PUBLIC_API_BASE_URL=/api
# Nơi chứa poster (S3/MinIO), ghép với movie.posterKey
NEXT_PUBLIC_ASSET_BASE_URL=http://localhost:9000/cinema
